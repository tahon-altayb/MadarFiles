<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_card" android:layoutDirection="rtl" android:padding="10dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
   <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
   <ProgressBar android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/widget_orbit_spin" android:indeterminateDuration="9000" android:indeterminateBehavior="repeat" android:interpolator="@android:anim/linear_interpolator"/>
   <TextView android:id="@+id/glyph" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="◉" android:textColor="#F8F4ED" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false"/>
  </FrameLayout>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_hub_title" android:textColor="#FFFDF8" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:textAlignment="viewStart"/>
    <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_hub_hint" android:textColor="#B9C7C2" android:textSize="11sp" android:singleLine="true" android:textAlignment="viewStart"/>
   </LinearLayout>
   <TextView android:id="@+id/go" android:layout_width="wrap_content" android:layout_height="34dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center" android:background="@drawable/widget_button" android:text="@string/widget_download_go" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
   <LinearLayout android:id="@+id/tool1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/dot1" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:background="@drawable/widget_dot" android:textColor="#FFFDF8" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"/>
    <TextView android:id="@+id/name1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#D7E0DC" android:textSize="11sp" android:singleLine="true"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/tool2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/dot2" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:background="@drawable/widget_dot" android:textColor="#FFFDF8" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"/>
    <TextView android:id="@+id/name2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#D7E0DC" android:textSize="11sp" android:singleLine="true"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/tool3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/dot3" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:background="@drawable/widget_dot" android:textColor="#FFFDF8" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"/>
    <TextView android:id="@+id/name3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#D7E0DC" android:textSize="11sp" android:singleLine="true"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/tool4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/dot4" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:background="@drawable/widget_dot" android:textColor="#FFFDF8" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"/>
    <TextView android:id="@+id/name4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#D7E0DC" android:textSize="11sp" android:singleLine="true"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/tool5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/dot5" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:background="@drawable/widget_dot" android:textColor="#FFFDF8" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"/>
    <TextView android:id="@+id/name5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#D7E0DC" android:textSize="11sp" android:singleLine="true"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/tool6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/dot6" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:background="@drawable/widget_dot" android:textColor="#FFFDF8" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"/>
    <TextView android:id="@+id/name6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#D7E0DC" android:textSize="11sp" android:singleLine="true"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
