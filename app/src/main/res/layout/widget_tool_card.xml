<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_card" android:layoutDirection="rtl" android:padding="10dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
   <FrameLayout android:layout_width="46dp" android:layout_height="46dp">
   <ProgressBar android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/widget_orbit_spin" android:indeterminateDuration="9000" android:indeterminateBehavior="repeat" android:interpolator="@android:anim/linear_interpolator"/>
   <TextView android:id="@+id/glyph" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="▷" android:textColor="#F8F4ED" android:textSize="19sp" android:textStyle="bold" android:includeFontPadding="false"/>
  </FrameLayout>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFDF8" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:textAlignment="viewStart"/>
    <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B9C7C2" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:textAlignment="viewStart"/>
   </LinearLayout>
   <TextView android:id="@+id/go" android:layout_width="wrap_content" android:layout_height="36dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center" android:background="@drawable/widget_button" android:text="@string/widget_pick" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/chips" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="8dp" android:orientation="horizontal">
   <TextView android:id="@+id/chip1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:background="@drawable/widget_chip" android:textColor="#FFFDF8" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:paddingStart="4dp" android:paddingEnd="4dp"/>
   <TextView android:id="@+id/chip2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:background="@drawable/widget_chip" android:textColor="#FFFDF8" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:paddingStart="4dp" android:paddingEnd="4dp"/>
   <TextView android:id="@+id/chip3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:background="@drawable/widget_chip" android:textColor="#FFFDF8" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:paddingStart="4dp" android:paddingEnd="4dp"/>
   <TextView android:id="@+id/chip4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:background="@drawable/widget_chip" android:textColor="#FFFDF8" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:paddingStart="4dp" android:paddingEnd="4dp"/>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
